<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090912"
    android:padding="20dp">

    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_alignParentTop="true"
        android:layout_marginTop="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RUMI AI ULTIMATE"
            android:textColor="#FF2E93"
            android:textSize="24sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="আপনার থ্রিডি এআই সহচর প্রস্তুত"
            android:textColor="#8A8A9E"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/avatarContainer"
        android:layout_width="132dp"
        android:layout_height="132dp"
        android:layout_below="@id/headerLayout"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="8dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:drawable/presence_online" />

        <ImageView
            android:id="@+id/imgRumiAvatar"
            android:layout_width="124dp"
            android:layout_height="124dp"
            android:layout_centerInParent="true"
            android:scaleType="centerCrop"
            android:background="@android:color/black"
            android:contentDescription="Rumi AI avatar" />
    </RelativeLayout>


    <LinearLayout
        android:id="@+id/quickActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/apiKeyLayout"
        android:orientation="vertical"
        android:layout_marginBottom="8dp"
        android:layout_marginTop="4dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚡ দ্রুত অপশন"
            android:textColor="#FF2E93"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnFacebook"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Facebook"
                android:textSize="10sp"
                android:minWidth="0dp"
                android:paddingHorizontal="2dp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1877F2" />

            <Button
                android:id="@+id/btnYouTube"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:text="YouTube"
                android:textSize="10sp"
                android:minWidth="0dp"
                android:paddingHorizontal="2dp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#E62117" />

            <Button
                android:id="@+id/btnGoogle"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Google"
                android:textSize="10sp"
                android:minWidth="0dp"
                android:paddingHorizontal="2dp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#4285F4" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <Button
                android:id="@+id/btnDial"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="📞 কল"
                android:textSize="11sp"
                android:minWidth="0dp"
                android:paddingHorizontal="2dp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#00897B" />

            <Button
                android:id="@+id/btnAlarm"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="⏰ অ্যালার্ম"
                android:textSize="11sp"
                android:minWidth="0dp"
                android:paddingHorizontal="2dp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#6A4C93" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btnVoiceSettings"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_alignParentBottom="true"
        android:text="👩 মেয়ে কণ্ঠ সেটিংস"
        android:textSize="12sp"
        android:textColor="#CCCCCC"
        android:backgroundTint="#1A1A32" />

    <Button
        android:id="@+id/btnSpeak"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_above="@id/btnVoiceSettings"
        android:layout_marginBottom="10dp"
        android:text="📞 রুমির সাথে লাইভ কথা শুরু করুন"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#FF2E93" />

    <LinearLayout
        android:id="@+id/chatBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/btnSpeak"
        android:orientation="vertical"
        android:background="#16162B"
        android:padding="14dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvUserCommand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="আপনি: বলুন..."
            android:textColor="#00F0FF"
            android:textSize="14sp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvRumiReply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="রুমি: আসসালামু আলাইকুম!"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/apiKeyLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/chatBox"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <EditText
            android:id="@+id/etApiKey"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:hint="Gemini API Key দিন (AIza...)"
            android:textColor="#FFFFFF"
            android:textColorHint="#666688"
            android:background="#1A1A2E"
            android:paddingHorizontal="12dp"
            android:textSize="12sp"
            android:singleLine="true"
            android:inputType="textPassword" />

        <Button
            android:id="@+id/btnSaveKey"
            android:layout_width="wrap_content"
            android:layout_height="45dp"
            android:text="Save"
            android:backgroundTint="#00C853"
            android:textColor="#FFFFFF"
            android:layout_marginStart="6dp" />
    </LinearLayout>

</RelativeLayout>
