<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#080812"
    android:gravity="center"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RUMI AI 3D"
        android:textColor="#FF2E93"
        android:textSize="28sp"
        android:textStyle="bold"
        android:letterSpacing="0.2" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="অফলাইন মোড"
        android:textColor="#00F0FF"
        android:textSize="13sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="24dp" />

    <FrameLayout
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:gravity="center"
        android:layout_marginBottom="24dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:drawable/presence_online" />

        <View
            android:id="@+id/aiCoreVisual"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:background="@android:drawable/star_big_on" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <EditText
            android:id="@+id/etApiKey"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:hint="Gemini API Key দিন (AIza...)"
            android:textColor="#FFFFFF"
            android:textColorHint="#666688"
            android:background="#151528"
            android:padding="10dp"
            android:textSize="12sp"
            android:singleLine="true"
            android:inputType="textPassword" />

        <Button
            android:id="@+id/btnSaveKey"
            android:layout_width="wrap_content"
            android:layout_height="45dp"
            android:text="Save"
            android:backgroundTint="#00C853"
            android:textColor="#FFFFFF"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#121222"
        android:padding="16dp"
        android:layout_marginBottom="20dp">

        <TextView
            android:id="@+id/tvUserCommand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="আপনি: কিছু বলুন..."
            android:textColor="#00F0FF"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvRumiReply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="রুমি: আসসালামু আলাইকুম! আমি আপনার এডিটেড রুমি।"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <Button
        android:id="@+id/btnSpeak"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="📞 রুমির সাথে লাইভ কথা শুরু করুন"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#FF2E93"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnVoiceSettings"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="👩 মেয়ে কণ্ঠ সেটিংস"
        android:textSize="12sp"
        android:textColor="#CCCCCC"
        android:backgroundTint="#1A1A32" />

</LinearLayout>