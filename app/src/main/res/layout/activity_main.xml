<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D0D1A"
    android:gravity="center"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvAssistantName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RUMI AI 2.0"
        android:textColor="#FF2E93"
        android:textSize="32sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="আপনার পার্সোনাল মেয়ে ভয়েস অ্যাসিস্ট্যান্ট"
        android:textColor="#8A8A9E"
        android:textSize="14sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="20dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">

        <EditText
            android:id="@+id/etApiKey"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="এখানে Gemini API Key পেস্ট করুন"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:background="#1A1A2E"
            android:padding="10dp"
            android:textSize="13sp"
            android:singleLine="true"
            android:inputType="textPassword" />

        <Button
            android:id="@+id/btnSaveKey"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Save"
            android:backgroundTint="#00C853"
            android:textColor="#FFFFFF"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1A1A2E"
        android:padding="20dp"
        android:layout_marginBottom="24dp">

        <TextView
            android:id="@+id/tvUserCommand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="আপনি: কিছু বলুন..."
            android:textColor="#00F0FF"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvRumiReply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="রুমি: আসসালামু আলাইকুম! আমি রুমি (ভার্সন ২.০)। আমাকে যেকোনো প্রশ্ন করুন!"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <Button
        android:id="@+id/btnSpeak"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="🎙️ রুমির সাথে কথা বলুন"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#FF2E93"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnVoiceSettings"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="👩 মেয়ে কণ্ঠ (Female Voice) সেটিংস ওপেন করুন"
        android:textSize="13sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#252542" />

</LinearLayout>
